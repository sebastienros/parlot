<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The cloned libraries name nuget.org differently: drop the package source mapping of Parlot's NuGet.config -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
  </packageSourceMapping>
</configuration>
