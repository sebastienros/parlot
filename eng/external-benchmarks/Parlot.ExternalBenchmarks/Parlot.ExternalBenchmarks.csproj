<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Benchmarks libraries that use Parlot, built from source against the Parlot checkout in $(ParlotRoot).
    Run ../setup.sh first, then ../run.sh. See ../README.md.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <Optimize>true</Optimize>
    <ExternalRepos Condition="'$(ExternalRepos)' == ''">$(MSBuildThisFileDirectory)../.repos</ExternalRepos>
    <!-- NCalc's grammar, compiled against the Parlot runtime as NCalc's own benchmarks do -->
    <DefineConstants>$(DefineConstants);PARLOT_FLUENT</DefineConstants>
    <!-- The external repositories are shallow clones: Nerdbank.GitVersioning can't compute a version height -->
    <NBGV_GitEngine>Disabled</NBGV_GitEngine>
  </PropertyGroup>

  <Target Name="RequireParlotRoot" BeforeTargets="Restore;Build">
    <Error Condition="'$(ParlotRoot)' == ''" Text="Pass -p:ParlotRoot=&lt;path of a Parlot checkout&gt;." />
  </Target>

  <ItemGroup>
    <AssemblyMetadata Include="ParlotRoot" Value="$(ParlotRoot)" />
    <AssemblyMetadata Include="ParlotCommit" Value="$(ParlotCommit)" />
    <AssemblyMetadata Include="ParlotVariant" Value="$(ParlotVariant)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(ParlotRoot)/src/Parlot/Parlot.csproj" />
    <ProjectReference Include="$(ExternalRepos)/fluid/Fluid/Fluid.csproj" />
    <ProjectReference Include="$(ExternalRepos)/ncalc/src/NCalc.Core/NCalc.Core.csproj" />
    <ProjectReference Include="$(ExternalRepos)/ncalc/src/NCalc.Parser/NCalc.Parser.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(ExternalRepos)/ncalc/src/NCalc.Parser/LogicalExpressionParser.parlot.cs" Link="NCalc/FluentExpressionParser.Grammar.cs" />
    <Compile Include="$(ExternalRepos)/ncalc/src/NCalc.Parser/LogicalExpressionParser.Helpers.cs" Link="NCalc/FluentExpressionParser.Helpers.cs" />
    <EmbeddedResource Include="$(ExternalRepos)/fluid/Fluid.Benchmarks/product.liquid" LogicalName="product.liquid" />
    <EmbeddedResource Include="$(ExternalRepos)/fluid/Fluid.Benchmarks/blogpost.liquid" LogicalName="blogpost.liquid" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.Globalization" />
  </ItemGroup>

</Project>
