<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <LangVersion>12</LangVersion>
    <IsPackable>false</IsPackable>
    <AnalysisLevel>latest-Default</AnalysisLevel>
    <SignAssembly>False</SignAssembly>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)\GeneratedFiles</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Pidgin" />
    <PackageReference Include="Sprache" />
    <PackageReference Include="Superpower" />
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\..\src\Parlot\Parlot.csproj" />
    <ProjectReference Include="..\..\src\Samples\Samples.csproj" />
    
    <!-- Reference the source generator as an analyzer -->
    <ProjectReference Include="..\..\src\Parlot.SourceGenerator\Parlot.SourceGenerator.csproj" 
                      OutputItemType="Analyzer" 
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="ArtifactsPath;OutDir;OutputPath;PublishDir" />
    
    <!-- Make Parlot.dll available while the analyzer executes build-only grammar factories -->
    <Analyzer Include="..\..\src\Parlot\bin\$(Configuration)\netstandard2.0\Parlot.dll" />
    
    <!-- Make Samples.dll available to the source generator at compile time -->
    <Analyzer Include="..\..\src\Samples\bin\$(Configuration)\net10.0\Samples.dll" />
  </ItemGroup>

  <!-- BenchmarkDotNet flattens project-reference outputs, so netstandard2.0 can overwrite the net10.0 Parlot assembly. -->
  <Target Name="CopyNet10ParlotForBenchmarkDotNet"
          AfterTargets="Build"
          Condition="'$(ArtifactsPath)' != ''">
    <Copy SourceFiles="..\..\src\Parlot\bin\$(Configuration)\net10.0\Parlot.dll"
          DestinationFiles="$(OutDir)Parlot.dll" />
  </Target>

  <Import Project="..\..\src\Parlot.SourceGenerator\build\Parlot.SourceGenerator.props" />
  <Import Project="..\..\src\Parlot.SourceGenerator\build\Parlot.SourceGenerator.targets" />

</Project>
