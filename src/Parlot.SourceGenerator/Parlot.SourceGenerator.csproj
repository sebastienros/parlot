<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Source generators typically target netstandard2.0 to work with multiple compiler hosts -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <Title>Parlot Source Generator</Title>
    <Description>Roslyn source generator for compiling Parlot parser combinators into optimized C# code.</Description>
    <PackageTags>parlot;parser;parser-combinator;source-generator;roslyn</PackageTags>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- Analyzer-only packages have no lib assets for a separate symbols package. -->
    <IncludeSymbols>false</IncludeSymbols>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NuspecFile>Parlot.SourceGenerator.nuspec</NuspecFile>
    <AssemblyOriginatorKeyFile>../Parlot/Parlot.snk</AssemblyOriginatorKeyFile>
    <SignAssembly>true</SignAssembly>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
    <LangVersion>Latest</LangVersion>
    <AnalyzerLanguage>cs</AnalyzerLanguage>
    <IsRoslynAnalyzer>true</IsRoslynAnalyzer>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EmitCompilerGeneratedFiles>false</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
    <DefineConstants>$(DefineConstants);SOURCE_GENERATOR</DefineConstants>
    <!-- Dependency groups describe generated consumers; analyzer-only packages intentionally have no lib assets. -->
    <NoWarn>$(NoWarn);RS2007;RS2008;NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference Parlot to get access to ISourceable, SourceGenerationContext, etc. -->
    <ProjectReference Include="..\Parlot\Parlot.csproj">
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="StandaloneRuntime/**/*.cs" />
    <EmbeddedResource Include="../Parlot/bin/$(Configuration)/netstandard2.0/Parlot.dll" LogicalName="Parlot.GrammarAssembly" />
    <EmbeddedResource Include="../../LICENSE" LogicalName="Parlot.StandaloneRuntime.License" />
    <EmbeddedResource Include="../Parlot/Scanner.cs" LogicalName="Parlot.StandaloneRuntime.Scanner.cs" />
    <EmbeddedResource Include="../Parlot/Cursor.cs" LogicalName="Parlot.StandaloneRuntime.Cursor.cs" />
    <EmbeddedResource Include="../Parlot/TextPosition.cs" LogicalName="Parlot.StandaloneRuntime.TextPosition.cs" />
    <EmbeddedResource Include="../Parlot/TextSpan.cs" LogicalName="Parlot.StandaloneRuntime.TextSpan.cs" />
    <EmbeddedResource Include="../Parlot/ParseResult.cs" LogicalName="Parlot.StandaloneRuntime.ParseResult.cs" />
    <EmbeddedResource Include="../Parlot/ParseException.cs" LogicalName="Parlot.StandaloneRuntime.ParseException.cs" />
    <EmbeddedResource Include="../Parlot/ParseError.cs" LogicalName="Parlot.StandaloneRuntime.ParseError.cs" />
    <EmbeddedResource Include="../Parlot/Option.cs" LogicalName="Parlot.StandaloneRuntime.Option.cs" />
    <EmbeddedResource Include="../Parlot/Character.cs" LogicalName="Parlot.StandaloneRuntime.Character.cs" />
    <EmbeddedResource Include="../Parlot/Character.Class.cs" LogicalName="Parlot.StandaloneRuntime.Character.Class.cs" />
    <EmbeddedResource Include="../Parlot/Character.Generated.cs" LogicalName="Parlot.StandaloneRuntime.Character.Generated.cs" />
    <EmbeddedResource Include="../Parlot/Character.Mask.cs" LogicalName="Parlot.StandaloneRuntime.Character.Mask.cs" />
    <EmbeddedResource Include="../Parlot/Character.SearchValues.cs" LogicalName="Parlot.StandaloneRuntime.Character.SearchValues.cs" />
    <EmbeddedResource Include="../Parlot/Numbers.cs" LogicalName="Parlot.StandaloneRuntime.Numbers.cs" />
    <EmbeddedResource Include="../Parlot/HexConverter.cs" LogicalName="Parlot.StandaloneRuntime.HexConverter.cs" />
    <EmbeddedResource Include="../Parlot/ThrowHelper.cs" LogicalName="Parlot.StandaloneRuntime.ThrowHelper.cs" />
    <EmbeddedResource Include="../Parlot/Polyfills/Polyfills.Numbers.cs" LogicalName="Parlot.StandaloneRuntime.Polyfills.Numbers.cs" />
    <EmbeddedResource Include="../Parlot/Polyfills/Polyfills.Char.cs" LogicalName="Parlot.StandaloneRuntime.Polyfills.Char.cs" />
    <EmbeddedResource Include="../Parlot/Polyfills/Polyfills.ArgumentNullException.cs" LogicalName="Parlot.StandaloneRuntime.Polyfills.ArgumentNullException.cs" />
    <EmbeddedResource Include="../Parlot/Fluent/ParseContext.cs" LogicalName="Parlot.StandaloneRuntime.Fluent.ParseContext.cs" />
    <EmbeddedResource Include="../Parlot/Fluent/HybridList.cs" LogicalName="Parlot.StandaloneRuntime.Fluent.HybridList.cs" />
    <EmbeddedResource Include="../Parlot/Fluent/NumberOptions.cs" LogicalName="Parlot.StandaloneRuntime.Fluent.NumberOptions.cs" />
    <EmbeddedResource Include="../Parlot/Fluent/DelegateParser.cs" LogicalName="Parlot.StandaloneRuntime.Fluent.DelegateParser.cs" />
    <EmbeddedResource Include="StandaloneRuntime/Parser.cs" LogicalName="Parlot.StandaloneRuntime.Fluent.Parser.cs" />
  </ItemGroup>

  <Target Name="SetParlotNuspecProperties" BeforeTargets="_GetOutputItemsFromPack">
    <PropertyGroup>
      <NuspecProperties>$(NuspecProperties);version=$(PackageVersion);configuration=$(Configuration);authors=$(Authors);description=$(Description);copyright=$(Copyright);memoryVersion=@(PackageVersion->WithMetadataValue('Identity', 'System.Memory')->Metadata('Version'))</NuspecProperties>
    </PropertyGroup>
  </Target>
  <Target Name="SetParlotNuspecRepository" BeforeTargets="GenerateNuspec" DependsOnTargets="SetParlotNuspecProperties">
    <PropertyGroup>
      <NuspecProperties>$(NuspecProperties);repositoryUrl=$(RepositoryUrl);repositoryCommit=$(RepositoryCommit)</NuspecProperties>
    </PropertyGroup>
  </Target>

</Project>
